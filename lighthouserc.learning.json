{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:3100/app/lesson/lesson-1"],
      "numberOfRuns": 1,
      "startServerCommand": "pnpm start --port 3100",
      "settings": {
        "disableStorageReset": true
      },
      "puppeteerScript": "scripts/lighthouse-guest.cjs",
      "puppeteerLaunchOptions": {
        "args": ["--no-sandbox"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "reports/lighthouse/learning-v2"
    }
  }
}
