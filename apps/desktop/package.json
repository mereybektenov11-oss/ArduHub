{
  "name": "@arduhub/desktop",
  "productName": "ArduHub",
  "version": "0.1.0",
  "private": true,
  "description": "ArduHub для ПК: обучение Arduino и 3D-практика (в разработке)",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "dist": "tsc -p tsconfig.main.json && vite build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "boxicons": "2.1.4",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "app.arduhub.desktop",
    "productName": "ArduHub",
    "copyright": "ArduHub",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ArduHub-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ArduHub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1049"
    },
    "publish": null
  }
}
