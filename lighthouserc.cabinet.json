{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:3100/app/profile"],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "disableStorageReset": true
      },
      "puppeteerScript": "scripts/lighthouse-guest.cjs",
      "puppeteerLaunchOptions": {
        "args": ["--no-sandbox"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./reports/lighthouse/cabinet"
    }
  }
}
