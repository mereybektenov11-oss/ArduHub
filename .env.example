# Server-only; never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SITE_URL=
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Groq: official OpenAI-compatible endpoint is configured on the server.
GROQ_API_KEY=
MENTOR_MODEL=openai/gpt-oss-120b
MENTOR_MODEL_FAST=openai/gpt-oss-20b

# YouTube Data API v3; cached/pinned selections work without this key.
YOUTUBE_API_KEY=

# Isolated Arduino CLI gateway. Without it, only exact trusted examples run.
COMPILER_API_URL=
COMPILER_API_KEY=
# Explicit trusted-local development mode; keep false for a public service.
LOCAL_COMPILER=false

# Accounts (public URL and anon/publishable key only)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set true to require Supabase configuration during startup/build.
AUTH_REQUIRED=false
# Enable status endpoints only on a local machine, never a public production host.
LOCAL_DEV_STATUS=false

# Alternative names from the dashboard specification (same isolated gateway):
COMPILER_URL=
COMPILER_SECRET=
# Optional dedicated test account; never enter a real student password here.
E2E_AUTH_EMAIL=
E2E_AUTH_PASSWORD=
