{
  "name": "arduhub-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "compile:smoke": "node scripts/compile-smoke.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "hex:build": "node scripts/build-hex-cache.mjs",
    "videos:resolve": "node --env-file-if-exists=.env.local scripts/resolve-videos.mjs",
    "parts:build": "node scripts/build-parts-catalog.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:motion-profile": "node scripts/profile-motion.mjs",
    "test:lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:lighthouse:cabinet": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.cabinet.json",
    "test:learning:coverage": "vitest run --config vitest.learning.config.ts --coverage",
    "test:learning:performance": "node scripts/profile-learning-v2.mjs",
    "test:lighthouse:learning": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.learning.json",
    "lint:type": "node scripts/lint-type.mjs",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:secrets": "node scripts/check-client-secrets.mjs",
    "test:services": "node --env-file-if-exists=.env.local scripts/check-live-services.mjs",
    "test:lighthouse:dashboard": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.dashboard.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@wokwi/elements": "^1.9.2",
    "avr8js": "^0.21.1",
    "motion": "^12.0.0",
    "next": "16.4.1",
    "openai": "^7.34.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
